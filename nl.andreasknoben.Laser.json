{
    "id" : "nl.andreasknoben.Laser",
    "runtime" : "org.gnome.Platform",
    "runtime-version" : "50",
    "sdk" : "org.gnome.Sdk",
    "command" : "laser",
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=all",
        "--talk-name=org.gtk.vfs.*",
        "--filesystem=xdg-run/gvfsd"
    ],
    "cleanup" : [
        "/include",
        "/lib/pkgconfig",
        "/share/info",
        "/share/man",
        "*.la",
        "*.a"
    ],
    "cleanup-commands": [
        "python3 -m compileall --invalidation-mode=unchecked-hash /app"
    ],
    "modules" : [
        {
            "name" : "libcdio",
            "buildsystem" : "autotools",
            "config-opts" : [
                "--disable-static",
                "--enable-shared"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/libcdio/libcdio/releases/download/2.4.0/libcdio-2.4.0.tar.gz",
                    "sha256" : "bf7cde63762bb12db7755c395c441e49406fde7e1d9f9a9be7e3b940b1f405d7"
                }
            ]
        },
        {
            "name": "paranoia",
            "buildsystem": "simple",
            "build-commands": [
                "cp config.guess.new configure.guess",
                "cp config.sub.new configure.sub",
                "./configure --prefix=/app",
                "make all slib",
                "make install"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url" : "http://downloads.xiph.org/releases/cdparanoia/cdparanoia-III-10.2.src.tgz",
                    "sha256": "005db45ef4ee017f5c32ec124f913a0546e77014266c6a1c50df902a55fe64df"
                },
                {
                    "type": "file",
                    "url": "https://cgit.git.savannah.gnu.org/cgit/config.git/plain/config.guess?id=428664896cf9e92d264976a960c76660938dffce",
                    "dest-filename": "config.guess.new",
                    "sha256": "ac18bbd7dc3769e1646af49ebba331a391829f4a73579b735dc8d439bd1c7f07"
                },
                {
                    "type": "file",
                    "url": "https://cgit.git.savannah.gnu.org/cgit/config.git/plain/config.sub?id=428664896cf9e92d264976a960c76660938dffce",
                    "dest-filename": "config.sub.new",
                    "sha256": "f9a31e9a3f5b7cbeb8d8c3f2015895a51e7222130114c9c363fcbccd78e4bf6b"
                }
            ]
        },
        {
            "name": "cdrdao",
            "buildsystem": "autotools",
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/cdrdao/cdrdao/releases/download/rel_1_2_6/cdrdao-1.2.6.tar.gz",
                    "sha256": "10d15b0dc78bd44a9a4a8d7d85498c734771036159d05aa940e17f18fc40d40f"
                }
            ]
        },
        {
            "name": "gst-plugins-base",
            "buildsystem": "meson",
            "config-opts": [
                "-Dgl=disabled",
                "-Dgl-graphene=disabled",
                "-Dgl-jpeg=disabled",
                "-Dgl-png=disabled",
                "-Daudioconvert=enabled",
                "-Daudioresample=enabled",
                "-Dcdparanoia=enabled",
                "-Dogg=enabled",
                "-Dopus=enabled",
                "-Dvorbis=enabled",
                "-Dcompositor=disabled",
                "-Dsubparse=disabled",
                "-Dtcp=disabled",
                "-Dvideoconvertscale=disabled",
                "-Dvideorate=disabled",
                "-Dvideotestsrc=disabled",
                "-Dlibvisual=disabled",
                "-Dtheora=disabled",
                "-Dx11=disabled",
                "-Dxshm=disabled",
                "-Dxvideo=disabled",
                "-Dxi=disabled",
                "-Ddoc=disabled"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://gstreamer.freedesktop.org/src/gst-plugins-base/gst-plugins-base-1.26.11.tar.xz",
                    "sha256": "fc50f885d41f5d0407ce0876ec7235d9e7b82d48db2f4bc72c5f244a4ac79263"
                }
            ]
        },
        {
            "name" : "gst-plugins-ugly",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dcdio=enabled",
                "-Dsidplay=disabled",
                "-Dgpl=enabled",
                "-Ddoc=disabled"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://gstreamer.freedesktop.org/src/gst-plugins-ugly/gst-plugins-ugly-1.26.11.tar.xz",
                    "sha256" : "bf9c9f72ee374825cfd43868c285bcb01700df2584069e75d7af455fe48244f8"
                }
            ]
        },
        {
            "name" : "libdiscid",
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/metabrainz/libdiscid/releases/download/v0.7.0/libdiscid-0.7.0.tar.gz",
                    "sha256" : "c230ed462c5ed7d7403ceb6984c57c8d05de42386d796bcd893636c0b0ba222f"
                }
            ]
        },
        {
            "name": "swig",
            "sources": [
                {
                    "type": "archive",
                    "url": "http://prdownloads.sourceforge.net/swig/swig-4.4.1.tar.gz",
                    "sha256": "40162a706c56f7592d08fd52ef5511cb7ac191f3593cf07306a0a554c6281fcf"
                }
            ]
        },
        {
            "name" : "cd-discid",
            "buildsystem" : "simple",
            "build-commands" : [
                "make",
                "make install PREFIX=/app"
            ],
            "sources" : [
                {
                    "type" : "archive",
                    "url" : "https://github.com/taem/cd-discid/archive/refs/tags/1.4.tar.gz",
                    "sha256" : "6f07df25ebf17b8336c17a50092ed288cc5a6b86f85705db7e1aa35ba26683cf"
                }
            ]
        },
        {
			"name": "python3-modules",
			"buildsystem": "simple",
			"build-commands": [],
			"modules": [
                {
                    "name": "python3-pycdio",
                    "buildsystem": "simple",
                    "build-commands": [
				        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"pycdio\" --no-build-isolation"
				    ],
				    "sources": [
                        {
                            "type": "file",
                            "url": "https://files.pythonhosted.org/packages/73/02/e482cd03681c641aba3863216029814443c023ac772ea5c638b3ff8e699f/pycdio-2.1.1.tar.gz",
                            "sha256": "61734db8c554b7b1a2cb2da2e2c15d3f9f5973a57cfb06f8854c38029004a9f8"
                        }
                    ]
                },
				{
				    "name": "python3-discid",
				    "buildsystem": "simple",
				    "build-commands": [
				        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"discid\" --no-build-isolation"
				    ],
				    "sources": [
				        {
				            "type": "file",
				            "url": "https://files.pythonhosted.org/packages/b3/1e/2ff9fc64a72764ed2efe9de3518b54125693ef2d05f7bcc547845a549cff/discid-1.4.2.tar.gz",
				            "sha256": "0cbb4b96949c68cbc63c9fc4585ef9b7ec2b9d39e23bce0b4db5d61c6f7b81e6"
				        }
				    ]
				},
				{
				    "name": "python3-musicbrainzngs",
				    "buildsystem": "simple",
				    "build-commands": [
				        "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"musicbrainzngs\" --no-build-isolation"
				    ],
				    "sources": [
				        {
				            "type": "file",
				            "url": "https://files.pythonhosted.org/packages/6d/fd/cef7b2580436910ccd2f8d3deec0f3c81743e15c0eb5b97dde3fbf33c0c8/musicbrainzngs-0.7.1-py2.py3-none-any.whl",
				            "sha256": "e841a8f975104c0a72290b09f59326050194081a5ae62ee512f41915090e1a10"
				        }
				    ]
				}
			]
		},
        {
            "name" : "laser",
            "buildsystem" : "meson",
            "sources" : [
                {
                    "type" : "archive",
                    "url": "https://codeberg.org/andreasknoben/Laser/archive/v0.5.0.tar.gz",
                    "sha256": "c33f33bbb2b1c13980617b8c88e35aa2178ff348936c366decc8f93f839aee7e"
                }
            ]
        }
    ]
}
